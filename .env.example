# Aria Premium Pharmacy & Wellness ERP - Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL/MariaDB)
# For local XAMPP/WAMP use: 127.0.0.1
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmacy_erp
DB_PORT=3306

# Authentication
# Change this to a long random string for production
JWT_SECRET=any_random_string_you_want

